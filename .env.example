# Copy to .env and fill in. Never commit .env — it is gitignored.

# --- Required --------------------------------------------------------------

# Password you type to log in. The app refuses to start without it, because it
# can send email on your behalf and must not be left open to the internet.
APP_PASSWORD=pick-a-long-password

# https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# --- Strongly recommended in deployment -------------------------------------

# Signs the login cookie. Without it a new random key is generated on each boot,
# which logs everyone out on every restart.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Where data lives. Defaults to a local SQLite file.
# IMPORTANT: on Railway (or any container host) the filesystem is wiped on every
# redeploy. Point this at Postgres there or you will lose every agent and message.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# --- Email (optional) -------------------------------------------------------
# Only needed if you want bots to send email. Nothing is ever sent without you
# confirming it in the UI first.

# GMAIL_USER=you@gmail.com
# Google Account > Security > 2-Step Verification > App Passwords (16 chars)
# GMAIL_APP_PASSWORD=

# Optional safety net: if set, email can only ever go to these addresses.
# GMAIL_ALLOWED_RECIPIENTS=me@example.com,teammate@example.com

# --- Tuning (optional) ------------------------------------------------------

# CHAT_MODEL=claude-opus-5
# EFFORT=medium              # low | medium | high | xhigh | max
# MAX_TOKENS=8192
# HISTORY_LIMIT=40           # turns of history re-sent per message
# MAX_TOOL_ROUNDS=6

# Browsers allowed to call the API cross-origin. Leave unset for same-origin only.
# ALLOWED_ORIGINS=https://your-app.up.railway.app

# PORT=8080
